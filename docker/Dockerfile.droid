# DROID-SLAM image — for Stage 7 (droid).
# Base: official PyTorch 1.10.0 + CUDA 11.3 devel image — includes nvcc and matching
# cuDNN / cudatoolkit. This is the combo DROID-SLAM was originally built against, so
# the C++/CUDA extensions compile cleanly without any of the surgery we did natively.
FROM pytorch/pytorch:1.10.0-cuda11.3-cudnn8-devel

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST="8.0;8.6"

# System tools for git clone + build
RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential ninja-build ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

# === Lock numpy < 2 BEFORE anything else (PyTorch 1.10 cannot use NumPy 2.x) ===
RUN pip install --no-cache-dir "numpy<2"

# === Downgrade pip so it accepts the old pytorch-lightning 1.5.10 metadata ===
RUN pip install --no-cache-dir "pip<24.1"

# === DROID-SLAM Python deps ===
#   --no-deps on pytorch-lightning so it doesn't try to "upgrade" torch
RUN pip install --no-cache-dir --no-deps pytorch-lightning==1.5.10
RUN pip install --no-cache-dir \
        scipy matplotlib pyyaml tqdm einops gdown tensorboard \
        opencv-python==4.5.5.64 Pillow
RUN pip install --no-cache-dir torch-scatter==2.0.9 \
        --no-index -f https://data.pyg.org/whl/torch-1.10.0+cu113.html
RUN pip install --no-cache-dir evo --upgrade --no-binary evo

# === Clone + build DROID-SLAM ===
RUN git clone --recursive https://github.com/princeton-vl/DROID-SLAM.git /opt/DROID-SLAM
WORKDIR /opt/DROID-SLAM
RUN python setup.py install

# === Download DROID-SLAM pretrained weights (~250 MB, baked into image) ===
RUN gdown 1PpqVt1H4maBa_GbPJp4NwxRsd9jk-elh -O /opt/DROID-SLAM/droid.pth \
    || bash /opt/DROID-SLAM/tools/download_model.sh

ENV DROID_SLAM_ROOT=/opt/DROID-SLAM

# Pipeline code is mounted at runtime via -v
WORKDIR /workspace

CMD ["bash", "-c", "python -c \"import torch, lietorch, droid_backends; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())\" && exec bash"]
